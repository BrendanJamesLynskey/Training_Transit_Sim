// Jenkins pipeline for Training_Transit_Sim.
//
// Stages: clean old reports -> virtualenv (pinned disagg-sim) -> lint -> tests (JUnit via pytest) ->
// results.md regenerated and checked unchanged -> an optional nightly bandwidth sweep.
//
// Needs on the agent: Python 3.10+ and git. Plugins: Pipeline, Git, JUnit.

pipeline {
    agent any

    parameters {
        booleanParam(name: 'NIGHTLY', defaultValue: false,
                     description: 'Also run the inter-DC bandwidth sweep (the nightly job sets this)')
        string(name: 'SWEEP_GBPS', defaultValue: '1 2 5 10 25 50 100 400 800',
               description: 'Inter-DC bandwidths (Gb/s) for the sweep stage')
        string(name: 'TARGET', defaultValue: '3.158',
               description: 'Target loss for the sweep (a ladder loss from the experiment)')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        // The workspace is reused between builds (it keeps the virtualenv), so delete the previous build's
        // reports first: a build that fails before its tests run must not publish the last build's results.
        stage('Clean reports') {
            steps {
                sh 'rm -f pytest-junit.xml sweep.csv'
            }
        }

        stage('Virtualenv') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install -q -e ".[dev]"
                    # The venv outlives builds, and pip keeps an installed git dependency whose version number
                    # has not changed, so reinstall the pinned commit every time.
                    .venv/bin/pip install -q --force-reinstall --no-deps "disagg-sim @ git+https://github.com/BrendanJamesLynskey/Disaggregated_Inference_Sim@69ffd2b8886c03f164bdb07dea954d1452169a06"
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '.venv/bin/ruff check --select E,F,W .'
            }
        }

        stage('Tests') {
            steps {
                sh '.venv/bin/pytest --junitxml=pytest-junit.xml'
            }
        }

        stage('Results') {
            steps {
                sh '.venv/bin/python examples/results.py > /dev/null'
                // every number in the README comes from results.md: it must regenerate unchanged
                sh "git diff --exit-code -I '^Generated by' examples/results.md examples/results.json"
                archiveArtifacts artifacts: 'examples/results.md, examples/results.json'
            }
        }

        stage('Nightly sweep') {
            when { expression { params.NIGHTLY } }
            steps {
                sh ".venv/bin/python scripts/sweep_bandwidth.py --target ${params.TARGET ?: '3.158'} --gbps ${params.SWEEP_GBPS ?: '1 2 5 10 25 50 100 400 800'} > sweep.csv"
                sh 'cat sweep.csv'
                archiveArtifacts artifacts: 'sweep.csv'
            }
        }
    }

    post {
        always {
            junit testResults: 'pytest-junit.xml', allowEmptyResults: true
        }
    }
}
